# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# SolidStart / vinxi / nitro
/.output
/.vinxi
/.nitro

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# Local scratch from the beta rewrite — a pre-rewrite snapshot and a tarball
# of in-progress edits. Kept on disk, never shipped.
/.backup-pre-beta
/_to_delete

# Raw screen captures. The webp files beside them are what the site serves;
# these are the multi-hundred-KB originals they were cropped from, and
# anything under public/ is copied into the build.
/public/screens/*-new.png
